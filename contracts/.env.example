# Never commit a populated copy of this file.
RPC_URL=https://your-rpc.example
# Only for npm run verify:etherscan (free key: etherscan.io > My Account > API Keys).
ETHERSCAN_API_KEY=
D17_EXPECTED_CHAIN_ID=11155111

# Canonical Sepolia defaults. Replace them for another compatible network.
WETH_ADDRESS=0xfff9976782d46cc05630d1f6ebab18b2324d6b14
UNISWAP_V2_ROUTER=0xeE567Fe1712Faf6149d80dA1E6934E354124CfE3

# Protocol fee (D17FeeConfig). Owner should be a multisig (Safe); mainnet requires a
# contract owner. The rate is hard-capped at 200 bps (2%) in the contract.
FEE_CONFIG_OWNER=
PROTOCOL_FEE_RECIPIENT=
PROTOCOL_FEE_BPS=100
# Optional: split the protocol fee with an ownerless D17FeeSplitter deployed with the suite.
# Comma-separated addresses and their shares in basis points (must add up to 10000).
# When set, leave PROTOCOL_FEE_RECIPIENT empty: the splitter becomes the recipient.
# Example: three recipients sharing 50%, 25% and 25%.
FEE_SPLIT_RECIPIENTS=
FEE_SPLIT_BPS=5000,2500,2500

# Deployment scripts require locally supplied funded signers.
D17_FACTORY_PRIVATE_KEY=
D17_LOCKER_FACTORY_PRIVATE_KEY=
# Optional. Defaults to D17_FACTORY_PRIVATE_KEY when unset.
D17_LAUNCH_FACTORY_PRIVATE_KEY=

# Renounce only after every pin transaction has succeeded and been checked.
RENOUNCE_D17_FACTORY_OWNER=1
ALLOW_SHARED_DEPLOYER=0
RPC_BATCH_MAX_COUNT=1

# create-launch.mjs
TOKEN_DEPLOYER_PRIVATE_KEY=
# Your own V15 D17Factory (from runs/factory-deployment.json after deploy:factory).
FACTORY_ADDRESS=
TREASURY_ADDRESS=
